<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="plume-launcher.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Plume\Plume Launcher">
    </Installer>
    <PackageInformation
        PackageName="Plume Launcher"
        PackageDisplayName="Plume Launcher"
        PublisherName="CN=Plume"
        PublisherDisplayName="Plume"
        Version="1.0.0.0"
        PackageDescription="Plume Launcher">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.plume.launcher"
                Description="Plume Launcher"
                DisplayName="Plume Launcher"
                ExecutableName="plume-launcher.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Plume Launcher</DisplayName>
            <PublisherDisplayName>Plume</PublisherDisplayName>
            <Description>Plume Launcher</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="plume-launcher.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
