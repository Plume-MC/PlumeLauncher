{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "bindings"]
}
